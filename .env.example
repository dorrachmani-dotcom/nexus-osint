# ============================================================================
#  Nexus-OSINT — configuration
#  Copy to ".env" and fill in only what you have. EVERYTHING IS OPTIONAL:
#  a missing key just disables that source (graceful degradation).
#
#  v1 is API-only: RSS works with no key; every other source needs its API key.
#  Stealth/scraping tracks (Telethon, twscrape, Nitter, DuckDuckGo) are a future
#  feature and are intentionally not wired up yet.
# ============================================================================

# ---------------------------------------------------------------------------
#  Intelligence core. Without an active provider, items are stored WITHOUT
#  analysis. Pick a backend with AI_PROVIDER (this is the default — it can also
#  be switched live from the Settings page).
#    AI_PROVIDER = auto | gemini | openai | anthropic | grok | local_openai | ollama | off
#  "auto" uses the first backend that is ready, in the order
#  gemini -> openai -> anthropic -> grok -> local_openai (only once a model is
#  set). Ollama is never picked automatically; choose it explicitly.
# ---------------------------------------------------------------------------
AI_PROVIDER=auto
# -- Anthropic (Claude) --
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-7
# -- Google (Gemini) --
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# -- OpenAI (ChatGPT) --
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# -- xAI (Grok) — OpenAI-compatible cloud API (key from console.x.ai) --
XAI_API_KEY=
# Default is the cheaper non-reasoning model; any id from docs.x.ai works
# (for example grok-4.7, the flagship reasoning model).
GROK_MODEL=grok-4.20-0309-non-reasoning
# -- Local OpenAI-compatible server (LM Studio, llama.cpp server, vLLM, Jan,
#    LocalAI). Runs on this machine: nothing leaves it. Set the model here or
#    pick it on the Settings page (Test connection lists what the server offers).
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=
# Only for servers started with an API key (e.g. vLLM --api-key). Usually empty.
LOCAL_LLM_API_KEY=
# -- Local model via Ollama (https://ollama.com) --
# Runs entirely on this machine, so NO analysed content ever leaves it — the
# privacy-first choice for orgs that can't send data to a cloud API. No key
# needed; just install Ollama, run `ollama pull <model>`, set AI_PROVIDER=ollama.
# See the README's "Run a fully local model" guide for hardware requirements.
OLLAMA_BASE_URL=http://localhost:11434
# Any Ollama model works. Default: Gemma 4 E4B (runs on most laptops). Step up
# to gemma4:12b, or qwen3.8:27b / gemma4:31b on a strong GPU.
# Pull with `ollama pull gemma4:e4b`.
OLLAMA_MODEL=gemma4:e4b
# Hard cap on items analysed per scan run (token-budget guard).
ANALYSIS_MAX_ITEMS_PER_RUN=100
# Language non-target content is translated into for the bilingual feed.
TRANSLATION_TARGET_LANG=English
# Skip analysing items shorter than this many characters (cost control).
PREFILTER_MIN_LENGTH=40

# ---------------------------------------------------------------------------
#  Keyless English-translation fallback (OPTIONAL)
#  The dashboard feed must always read in English. The AI analysis pass above
#  normally produces that translation — but with no AI provider, non-English
#  items would otherwise stay in their original language. This fallback fills
#  the gap WITHOUT any API key.
#
#  Point LIBRETRANSLATE_URL at a LibreTranslate instance (self-hosted, or a
#  public one). We call its plain HTTP API (POST /translate) ONLY as an external
#  web service — LibreTranslate is AGPL-licensed, and is never linked, bundled,
#  or imported as code by this project, so its source-distribution terms are not
#  triggered here. Leave blank to disable the HTTP backend.
#
#  An optional offline backend (the MIT-licensed `argostranslate` package, a
#  guarded import) is also used if you happen to have it installed — no config
#  needed. With neither configured, the fallback is a silent no-op and items
#  simply show in their original language with a language tag.
#
#  Examples:
#    LIBRETRANSLATE_URL=https://libretranslate.com         (public instance)
#    LIBRETRANSLATE_URL=https://translate.your-domain.tld  (your self-host)
LIBRETRANSLATE_URL=

# ---------------------------------------------------------------------------
#  Unified investigation queries
#  One search term broadcast to EVERY keyword-capable source at once (worldwide
#  news via GDELT, Google News, Twitter/X, Reddit search, Telegram search). This
#  is the "monitor X everywhere" backbone — normally managed from the
#  dashboard's Topics page. Comma-separated, e.g. LockBit,"John Doe",Tesla
#
#  Search-language rule: the language a term is written in is the language of
#  the results returned. A term in Chinese/Arabic/Russian collects that
#  language's coverage; the feed still reads in English with the original one
#  click away. For Latin-script languages prefix a term to force one, e.g.
#  "lang:es Neymar" for Spanish coverage. GDELT (worldwide news, 100+ languages)
#  is keyless and on automatically whenever any query term exists.
#
#  ---- WORKED EXAMPLE (disabled — it is a comment, so it will NOT run) --------
#  To try it, copy the terms after the "#" onto the real INVESTIGATION_QUERIES
#  line below, then run a scan. Quote any term that contains spaces.
#
#      INVESTIGATION_QUERIES=LockBit,"data breach","John Doe",Tesla
#
#  That one line tells Nexus to monitor four things everywhere at once: the
#  ransomware group "LockBit", the phrase "data breach", a person "John Doe",
#  and the company "Tesla". Leave the real line blank to start with nothing.
#  ----------------------------------------------------------------------------
INVESTIGATION_QUERIES=

# ---------------------------------------------------------------------------
#  RSS (always-on backbone, no key needed)
# ---------------------------------------------------------------------------
# Comma-separated RSS feed URLs to ingest, e.g. https://a.com/feed,https://b.com/rss
RSS_FEEDS=

# ---------------------------------------------------------------------------
#  News / Search — SERPAPI (https://serpapi.com)
# ---------------------------------------------------------------------------
SERPAPI_KEY=
# Comma-separated Google News queries, e.g. cyber attack,data breach
SERPAPI_QUERIES=
# How far back keyless Google News results may come from, in days (bounds both
# freshness and volume). 7 = last week, 1 = last day, 0 = no limit.
NEWS_WINDOW_DAYS=7

# ---------------------------------------------------------------------------
#  Google Custom Search (JSON API) — official keyed web/news search
#  Needs BOTH values. Key: https://developers.google.com/custom-search/v1
#  Engine ID (cx): https://programmablesearchengine.google.com (search whole web)
# ---------------------------------------------------------------------------
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---------------------------------------------------------------------------
#  Telegram — Telemetry API (telemetryapp.io / api.telemetr.io)
# ---------------------------------------------------------------------------
# Telemetry is a search/analytics service over public Telegram channels.
# Get an access key from its @telemetrio_api_bot on Telegram (it is sent as an
# `api_key` header). Without a key the Telegram source is simply skipped.
TELEMETRY_API_KEY=
# Comma-separated public channels to scan, e.g. durov,telegram (@ optional).
TELEGRAM_CHANNELS=
# Documented API host. telemetryapp.io and api.telemetr.io are the same
# service; only override if your endpoint differs.
TELEMETRY_BASE_URL=https://api.telemetr.io/v1

# ---------------------------------------------------------------------------
#  Twitter / X — official API bearer token
# ---------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=
# Comma-separated recent-search queries, e.g. #osint,disinformation
TWITTER_QUERIES=

# ---------------------------------------------------------------------------
#  Reddit (low-auth)
# ---------------------------------------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=nexus-osint/0.1
# Comma-separated subreddits to pull new posts from, e.g. worldnews,OSINT
REDDIT_SUBREDDITS=

# ---------------------------------------------------------------------------
#  Plug & Play OSINT tools (secrets some CLI adapters need)
#  Most tools (Sherlock, Maigret, holehe, GHunt, PhoneInfoga, theHarvester,
#  SpiderFoot, OnionSearch) need no key — they are used if the binary is on
#  PATH and skipped otherwise. The one exception is Toutatis below.
# ---------------------------------------------------------------------------
# Instagram session cookie used ONLY by the Toutatis adapter. It lives here in
# .env and is never written to the database or shown in the UI (OpSec). Without
# it the Toutatis adapter reports itself unavailable and is skipped.
INSTAGRAM_SESSIONID=

# ---------------------------------------------------------------------------
#  Security center — optional VirusTotal lookup (OFF by default)
#  The Security page's file scanner runs entirely on this machine. If — and only
#  if — you set a VirusTotal API key here, it ALSO checks a scanned file's
#  SHA-256 *hash* (never the file itself) against VirusTotal's database. That
#  hash lookup is the one and only part of the security layer that uses the
#  network, and only when you opt in by providing this key. Free key:
#  https://www.virustotal.com  (ClamAV, if `clamscan` is on PATH, is used
#  automatically and needs no key.)
# ---------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=

# ---------------------------------------------------------------------------
#  Internet Archive / Wayback Machine (OPTIONAL)
#  Archiving works without keys (anonymous Save Page Now). With both keys from
#  archive.org/account/s3.php captures use the authenticated SPN2 API (more
#  reliable, higher limits). Note: every capture is PUBLIC.
# ---------------------------------------------------------------------------
ARCHIVE_ORG_ACCESS_KEY=
ARCHIVE_ORG_SECRET_KEY=

# ---------------------------------------------------------------------------
#  Daily email brief written by Sherlock (OPTIONAL, OFF by default)
#  Easiest from Settings -> "Daily email brief": pick Gmail, Outlook, Resend,
#  SendGrid or a custom SMTP server, paste the password/key, press "Send test
#  email", then switch the brief on. This is an explicit opt-in that sends a
#  summary of your new items off this machine to the mail service you choose.
#  EMAIL_PROVIDER = gmail | outlook | smtp | resend | sendgrid  (inferred if empty)
#  Gmail needs an App Password (Google account -> Security -> 2-Step
#  Verification -> App passwords), never your normal password.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
# Custom SMTP only (Gmail/Outlook presets fill these in). 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=
# Your sign-in address (Gmail / Outlook / SMTP).
SMTP_USERNAME=
# SMTP password or app password (secret).
SMTP_PASSWORD=
# The From address (defaults to SMTP_USERNAME for SMTP; required for the APIs).
SMTP_FROM=
# Recipients, comma-separated.
DIGEST_TO=
# Email API services (secret keys; use one of them instead of SMTP).
RESEND_API_KEY=
SENDGRID_API_KEY=
# "Connect Gmail" (OAuth, send-only, no password). Your own Google Cloud OAuth
# client of type Desktop app. The refresh token and address are written by the
# Connect button in Settings; leave them empty here.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_EMAIL=

# ---------------------------------------------------------------------------
#  Storage / runtime
# ---------------------------------------------------------------------------
DATA_DIR=data
DATABASE_PATH=data/nexus.db
